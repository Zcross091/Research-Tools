{
  "appId": "com.omniresearch.desktop",
  "productName": "OmniResearch",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "guid": "5c9b1062-811c-4394-bb9e-1082c9f56e92",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "OmniResearch",
    "deleteAppDataOnUninstall": false,
    "differentialPackage": true
  }
}
